{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ciphernova.local/schema/v1/case.schema.json",
  "title": "CipherNova v1 create_case payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "subject", "consistency_claim", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": ".*\\S.*"},
    "subject": {"type": "string", "minLength": 1, "maxLength": 800, "pattern": ".*\\S.*"},
    "consistency_claim": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": ".*\\S.*"},
    "records": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "label", "source_url"],
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
          },
          "label": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": ".*\\S.*"},
          "source_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^https://[^?#\\s]+$"
          }
        }
      }
    }
  }
}
